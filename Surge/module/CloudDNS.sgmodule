# DNS over HTTPS (DoH)
# h8.8.8.8
[Host]
# betray.dpdns.org
betray.dpdns.org = server:8.8.8.8
*.betray.dpdns.org = server:8.8.8.8
# sylvanas.qzz.io
sylvanas.qzz.io = server:8.8.8.8
*.sylvanas.qzz.io = server:8.8.8.8
# sylvanas.dpdns.org
sylvanas.dpdns.org = server:8.8.8.8
*.sylvanas.dpdns.org = server:8.8.8.8
