#!name=DNS解析
#!desc=DNS解析
#!version=1.0.0

# DNS over HTTPS (DoH)
# https://dns.google/dns-query
[Host]
# betray.dpdns.org
betray.dpdns.org = server:https://dns.google/dns-query
*.betray.dpdns.org = server:https://dns.google/dns-query
# sylvanas.qzz.io
sylvanas.qzz.io = server:https://dns.google/dns-query
*.sylvanas.qzz.io = server:https://dns.google/dns-query
# sylvanas.dpdns.org
sylvanas.dpdns.org = server:https://dns.google/dns-query
*.sylvanas.dpdns.org = server:https://dns.google/dns-query
