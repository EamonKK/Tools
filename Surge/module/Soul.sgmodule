#!name=Soul去广告
#!desc=移除广告和精简页面
#!author=ZenmoFeiShi, RuCu6, 可莉, kelv1n1n, wish
#!icon=https://raw.githubusercontent.com/mist-whisper/Icon/master/App_icon/120px/Soul.png
#!system=ios
#!arguments=PROXY:DIRECT
#!arguments-desc=PROXY:选择分流策略组，默认DIRECT。

[Rule]
IP-CIDR, 8.210.3.170/32, {{{PROXY}}}, no-resolve
IP-CIDR, 47.75.72.47/32, {{{PROXY}}}, no-resolve

[Map Local]
# 广告下发
^https:\/\/ssp\.soulapp\.cn\/api\/q data-type=text data="{\"code\":200,\"data\":null}" status-code=200
^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 去除青少年弹窗
^https:\/\/api-account\.soulapp\.cn\/teenager\/config data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 谁看过我横幅广告
^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 主页右下角悬浮广告
^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 拒绝收集用户数据
^https:\/\/data-collector\.soulapp\.cn\/api\/data\/report\/v2 data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 私聊用户匹配推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 派对体验反馈
^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 广场关注tab用户派对推荐
^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 聊天页通讯录tab邀请好友回归横幅
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings data-type=text data="{\"code\":200,\"data\":null}" status-code=200
# 主页ai描述推荐
^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc data-type=text data="{\"code\":200,\"data\":null}" status-code=200

[Script]
派对猜你喜欢 = type=http-response, pattern=^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js, requires-body=true

去除私聊限制 = type=http-response, pattern=^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js, requires-body=true

星球页面按钮 = type=http-response, pattern=^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js, requires-body=true

派对列表中间横幅官方广告 = type=http-response, pattern=^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js, requires-body=true

个人主页数量提示 = type=http-response, pattern=^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js, requires-body=true

个人主页tab = type=http-response, pattern=^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js, requires-body=true

{{{阅后即焚}}} = type=http-response, pattern=^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url, script-path=https://raw.githubusercontent.com/EamonKK/Tools/refs/heads/main/Scripts/Soul.js,requires-body=true,max-size=-1,binary-body-mode=1

[MITM]
hostname = %APPEND% ssp.soulapp.cn, increase-openapi.soulapp.cn, data-collector.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, 47.110.187.87
